# Deployment secrets. Copy to .env (never committed) and fill in.

# A fresh key used only for deploying. It becomes the contract owner, the
# treasury and the royalty receiver until those are moved to a multisig.
# Base Sepolia ETH for gas: https://docs.base.org/base-chain/tools/network-faucets
DEPLOYER_PRIVATE_KEY=

# Optional. Default to the public endpoints, which are fine for a deployment.
BASE_SEPOLIA_RPC_URL=
BASE_RPC_URL=

# Source verification. One key covers Base and Base Sepolia (Etherscan API v2).
# Free at https://etherscan.io/apis
ETHERSCAN_API_KEY=

# Optional collection metadata (ERC-7572) and the base for each token's
# external_url (<SITE_URL>/r/<tokenId>). Both can be set later by the owner.
CONTRACT_URI=
SITE_URL=
