# Pinata JWT for pinning ring artwork to IPFS (https://app.pinata.cloud/developers/api-keys).
# Used by the artwork pinning script only; never shipped to the browser.
PINATA_JWT=

# Deployed JoyRings address, used by packages/contracts/scripts/sync-media.ts
# to point on-chain models at the pinned artwork.
JOYRINGS_ADDRESS=
